pipeline{
    agent any
    stages{
        stage('Configure'){
            steps{
                echo "Here we are configuring the github repo to pipeline"
                git branch: 'main'
                url:  "https://github.com/Rahul-200324/EMI_Calculater_project.git"
            }
        }
        stage('Build){
            steps{
                echo "Here we are Building the application using docker"
                sh '''
                  docker build -t emi-calculate-image .
                '''
            }
        }
        stage('Test'){
            steps{
                echo "Here we are going to test the application weather its defect free or not"
            }
        }
        stage('Deploy'){
            steps{
                echo"Here we are deploying the application using docker"
                sh '''
                  docker run -d --name emi-calculater-container -p 5050:80 emi-calculate-image
                  '''
                }
        }
        stage("Deloyed"){
            steps{
                echo "Here we are checking the deployed application"
                sh '''
                  curl http://localhost:5050
                  '''
            }
        }
    }
}